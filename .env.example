# TikTok Marketing API 환경변수 템플릿
# 실제 값은 .env 파일에 저장 (.env는 gitignore됨)

TIKTOK_APP_ID=your_app_id_here
TIKTOK_APP_SECRET=your_app_secret_here
TIKTOK_ACCESS_TOKEN=your_access_token_here
TIKTOK_ADVERTISER_ID=your_advertiser_id_here

# 텔레그램 봇 일일 알림 (Phase 3)
# 1. @BotFather에서 /newbot → 봇 생성 후 token 받기
# 2. 운영 채널·단톡방에 봇 초대 + 메시지 보내고 chat_id 확인
#    (방법: https://api.telegram.org/bot<TOKEN>/getUpdates 호출 후 chat.id 확인)
# 3. 매일 03:30 자동 발송: python -m dashboard.workers.telegram_notifier
# 4. 메시지 확인만: python -m dashboard.workers.telegram_notifier --dry-run
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
