# Vercel 배포 시 Environment Variables에 등록
# 로컬 개발은 web/.env.local (gitignore됨)에 작성

# 사이트 접근 비밀번호 — 이 값 설정 시 /login 필수
ACCESS_PASSWORD=your-strong-password-here

# 로컬 dev 인증 생략 스위치 (production 에선 절대 true 금지)
# ALLOW_DEV_BYPASS=true

# 세션 쿠키 HMAC 서명 키 (production 필수 — 미설정 시 ACCESS_PASSWORD를 서명 키로 사용)
SESSION_SECRET=long-random-string-at-least-32-chars

# 액션 실행 확인 비밀번호 — /tracker의 "실행" 버튼 누를 때 재확인용
ADMIN_PASSWORD=your-admin-password-here

# TikTok Marketing API (루트 .env와 동일 값 — Vercel 배포 시 등록 필요)
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
